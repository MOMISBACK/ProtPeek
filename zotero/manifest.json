{
  "manifest_version": 2,
  "name": "ProtPeek for Zotero",
  "version": "0.1.1",
  "description": "Inspect protein structures while reading papers in Zotero. Local scanning, bundled Mol* viewer.",
  "author": "Emile Dupuy",
  "homepage_url": "https://github.com/MOMISBACK/ProtPeek",
  "icons": { "48": "icon-48.png", "96": "icon-96.png" },
  "applications": {
    "zotero": {
      "id": "protpeek-zotero@momisback.github.io",
      "update_url": "https://raw.githubusercontent.com/MOMISBACK/ProtPeek/main/zotero/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  }
}
